# Serai — required API keys
# Copy this file to .env and fill in your values.

# LLM provider: "openai" (default), "anthropic", or "google"
MODEL_PROVIDER=openai

# OpenAI — required when MODEL_PROVIDER=openai
# Get your key at https://platform.openai.com/api-keys
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini

# Anthropic — required when MODEL_PROVIDER=anthropic
# Get your key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=your-anthropic-api-key-here
ANTHROPIC_MODEL=claude-sonnet-4-6

# Google Gemini — required when MODEL_PROVIDER=google
# Get your key at https://aistudio.google.com/apikey
GOOGLE_API_KEY=your-google-api-key-here
GOOGLE_MODEL=gemini-2.5-flash

# Brave Search — used for real-time signal grounding
# Get your key at https://brave.com/search/api/
BRAVE_SEARCH_API_KEY=your-brave-api-key-here

# Notion — used for writing results to your tracking database
# Create an integration at https://www.notion.so/my-integrations
NOTION_TOKEN=your-notion-integration-api-key-here

# Notion database ID — the ID from your database URL
# Example: https://notion.so/your-workspace/DATABASE_ID?v=...
NOTION_DATABASE_ID=your-notion-database-id-here
RUN_METRICS_DATABASE_ID=your-notion-database-id-here
